# hpc_local.env.example -- per-machine HPC settings (template).
#
# Every Script_Bank/HPC/*.sh sources `hpc_local.env` at startup, so one set of
# generic, committed scripts runs unchanged on any cluster: each machine supplies
# its own values here instead of editing the scripts. Mirrors the
# machine_profiles.toml / machine_profiles.example.toml pattern.
#
#   cp hpc_local.env.example hpc_local.env      # then edit for this machine
#
# `hpc_local.env` is gitignored and never committed.

# Profile name in machine_profiles.toml (selects this machine's data/compute paths).
export MACHINE_PROFILE=my_profile

# conda profile script that defines `conda` in a non-interactive shell.
export CONDA_SETUP="$HOME/miniconda3/etc/profile.d/conda.sh"

# Monitoring/batch-log output directory (must already exist).
export MON_OUT="$HOME/process_monitoring"
export MON="$MON_OUT"

# --- generation controller only ---
# CPU partition for generation (passed as `sbatch --partition` only when non-empty;
# otherwise the launcher's baked #SBATCH --partition applies).
export PART=
# Slurm account, if your cluster requires one (passed as `sbatch --account` when set).
export ACCT=
# Queue-owner username for polling (defaults to $USER if left unset).
export USER_ME="$USER"

# REPO is the repo root. Slurm spools each batch script to /var/spool, so a job's
# own path is NOT the repo -- the stage scripts resolve REPO in order from: an
# explicit REPO (--export=ALL,REPO=...), the Slurm submit directory (SLURM_SUBMIT_DIR,
# set when you sbatch from the repo root), then the script's own location (the
# non-Slurm `bash <script>` fallback only). So a bare `sbatch` MUST either be run
# from the repo root or pass REPO explicitly; otherwise the job fails loud because
# the spooled copy cannot find the package. The generation controller forwards REPO
# automatically. Setting REPO here is optional and only helps when this env file is
# itself sourced from the repo root before submitting.
# export REPO="$HOME/path/to/srm-and-sbi-dimer-alp"
